# Copy to .env (or set in PowerShell: $env:MOVIEAI_CORS_ORIGINS="http://localhost:5173")
# All variables are optional; defaults are shown.
MOVIEAI_DATA_PATH=data/MOVIEAI_Movies_Enriched_For_Recommendation.csv
MOVIEAI_ARTIFACTS_DIR=artifacts
MOVIEAI_REPORTS_DIR=reports
MOVIEAI_WEIGHT_PLOT=0.70
MOVIEAI_WEIGHT_GENRE=0.25
MOVIEAI_WEIGHT_DIRECTOR=0.05
MOVIEAI_TFIDF_MAX_FEATURES=50000
MOVIEAI_TFIDF_MIN_DF=2
MOVIEAI_CALIBRATE_PLOT=1
MOVIEAI_USE_ARTIFACT_CACHE=1
# Comma-separated list of allowed browser origins. Never "*" by default.
MOVIEAI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MOVIEAI_LOG_LEVEL=INFO
